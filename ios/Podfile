platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler_apple compiles every one of its nineteen permission
    # strategies behind a preprocessor macro that defaults to 0. With the macro
    # unset, AudioVideoPermissionStrategy compiles to `@implementation ... @end`
    # — a class declared as conforming to PermissionStrategy that implements
    # none of it. PermissionManager does not check respondsToSelector:, so
    # Permission.camera.request() sends an unrecognized selector, Objective-C
    # raises, and the app aborts with SIGABRT the first time anyone taps
    # "Take a new photo".
    #
    # Nothing catches this without running the flow: it compiles and links
    # cleanly, and `otool -oV` on the built framework is the only static
    # evidence (baseMethods 0x0 on the empty class).
    #
    # Only the camera is enabled. Every other macro stays at its default of 0,
    # which keeps Contacts, Location, Microphone, Speech, Media Library,
    # Sensors, Bluetooth, Notifications and AppTrackingTransparency out of the
    # binary — that absence is load-bearing for the store privacy labels, so if
    # you add a permission here, update docs/PRODUCT_SPEC.md with it.
    #
    # Pinned by test/ios_permission_macros_test.dart.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
      ]
    end
  end
end
