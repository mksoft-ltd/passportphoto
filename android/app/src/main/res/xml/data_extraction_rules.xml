<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 (API 31) and above. `android:allowBackup="false"` in the manifest
    already opts this app out of cloud backup; this file states the same thing
    in the form the newer API uses, and covers device-to-device transfer, which
    is a separate channel from Auto Backup.

    Nothing this app stores is worth carrying to another device. There are two
    keys in SharedPreferences: `pro_unlocked`, which is a cache of a store
    purchase, and `last_used_spec_id`, which is a UI convenience. Restoring the
    first onto a device signed into a different store account would grant the
    paid unlock to an account that never bought it, and "Restore purchase" on
    the home screen is the supported — and store-verified — way back to Pro.
    The photographs themselves live in the cache directory, which is excluded
    from both channels by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
